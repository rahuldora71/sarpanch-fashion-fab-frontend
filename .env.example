# ==============================================================================
# Sarpanch Fashion Fab (SFF) ERP — Frontend Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local overrides.
# For Vercel production deployment, configure these in Project Settings -> Environment Variables.

# Backend API Base URL (with /api/v1 suffix)
# Local development:  http://localhost:8082/api/v1
# Vercel production:  https://<your-render-service-name>.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8082/api/v1

# Backend Root Base URL (without /api/v1 suffix, for OAuth2 redirects)
# Local development:  http://localhost:8082
# Vercel production:  https://<your-render-service-name>.onrender.com
VITE_API_BASE_URL_ROOT=http://localhost:8082

# Post-login destination route
VITE_LOGIN_SUCCESS_REDIRECT_URL=/home

# Default pagination size for Customer CRM table
VITE_CUSTOMERS_PAGE_SIZE=15
